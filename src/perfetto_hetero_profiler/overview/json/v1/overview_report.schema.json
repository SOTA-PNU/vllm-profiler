{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfetto-hetero-profiler.local/overview/v1/overview_report.schema.json",
  "title": "Deterministic Overview Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "run",
    "workload",
    "models",
    "hardware",
    "kpis",
    "resources",
    "data_quality",
    "perfetto",
    "native_profiles",
    "interpretation"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "overview_report"},
    "run": {"$ref": "#/$defs/run"},
    "workload": {"$ref": "#/$defs/workload"},
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/model"}
    },
    "hardware": {
      "type": "array",
      "items": {"$ref": "#/$defs/hardware"}
    },
    "kpis": {"$ref": "#/$defs/kpi_sections"},
    "resources": {
      "type": "array",
      "items": {"$ref": "#/$defs/resource_summary"}
    },
    "data_quality": {"$ref": "#/$defs/data_quality"},
    "perfetto": {"$ref": "#/$defs/perfetto"},
    "native_profiles": {
      "type": "array",
      "items": {"$ref": "#/$defs/native_profile"}
    },
    "interpretation": {"$ref": "#/$defs/interpretation"}
  },
  "$defs": {
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_count",
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "concurrency",
        "request_rate_per_s",
        "warmup_requests",
        "max_output_tokens",
        "temperature",
        "retry_count",
        "prompt_sha256",
        "request_body_sha256",
        "offline",
        "max_model_len",
        "block_size"
      ],
      "properties": {
        "request_count": {"type": ["integer", "null"], "minimum": 0},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "concurrency": {"type": ["integer", "null"], "minimum": 0},
        "request_rate_per_s": {"type": ["number", "null"], "minimum": 0},
        "warmup_requests": {"type": ["integer", "null"], "minimum": 0},
        "max_output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "temperature": {"type": ["number", "null"], "minimum": 0},
        "retry_count": {"type": ["integer", "null"], "minimum": 0},
        "prompt_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "request_body_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "offline": {"type": ["boolean", "null"]},
        "max_model_len": {"type": ["integer", "null"], "minimum": 0},
        "block_size": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "mode",
        "profile_mode",
        "status",
        "profiler_kind",
        "canonical_clock_domain_id"
      ],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "mode": {"enum": ["gpu_only", "npu_only", "hybrid"]},
        "status": {
          "enum": [
            "planned",
            "running",
            "succeeded",
            "failed",
            "partial",
            "cancelled"
          ]
        },
        "profile_mode": {"enum": ["monitor", "detailed_profile"]},
        "profiler_kind": {"type": "string", "minLength": 1},
        "canonical_clock_domain_id": {"type": "string", "minLength": 1}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "model_id", "revision", "dtype"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "revision": {"type": ["string", "null"], "minLength": 1},
        "dtype": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_type",
        "device_id",
        "vendor",
        "model",
        "memory_total_bytes"
      ],
      "properties": {
        "device_type": {"type": "string", "minLength": 1},
        "device_id": {"type": "string", "minLength": 1},
        "vendor": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "memory_total_bytes": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "record_ids",
        "metric_names",
        "root_id",
        "relative_path",
        "details"
      ],
      "properties": {
        "source_kind": {"type": "string", "minLength": 1},
        "record_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "metric_names": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "root_id": {"type": ["string", "null"], "minLength": 1},
        "relative_path": {"type": ["string", "null"], "minLength": 1},
        "details": {"type": "object"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "scope_type",
        "observation_layer",
        "request_id",
        "host_id",
        "device_type",
        "device_id",
        "phase",
        "window"
      ],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "scope_type": {
          "enum": ["run", "request", "phase", "host", "process", "device", "transfer"]
        },
        "observation_layer": {
          "enum": [
            "request_facing_client",
            "hybrid_pipeline",
            "normalized_resource_metric",
            "gpu_only",
            "npu_only",
            "run"
          ]
        },
        "request_id": {"type": ["string", "null"], "minLength": 1},
        "host_id": {"type": ["string", "null"], "minLength": 1},
        "device_type": {"type": ["string", "null"], "minLength": 1},
        "device_id": {"type": ["string", "null"], "minLength": 1},
        "phase": {"type": ["string", "null"], "minLength": 1},
        "window": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method_id", "formula"],
      "properties": {
        "method_id": {"type": "string", "minLength": 1},
        "formula": {"type": "string", "minLength": 1}
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_ids",
        "alignment_status",
        "alignment_method",
        "offset_ns",
        "uncertainty_ns"
      ],
      "properties": {
        "domain_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "alignment_status": {
          "enum": [
            "canonical",
            "aligned",
            "partial",
            "unaligned",
            "not_applicable",
            "not_available",
            "unknown"
          ]
        },
        "alignment_method": {"type": ["string", "null"], "minLength": 1},
        "offset_ns": {"type": ["integer", "null"]},
        "uncertainty_ns": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "scale_numerator",
        "scale_denominator",
        "decimal_places",
        "rounding"
      ],
      "properties": {
        "unit": {"type": "string", "minLength": 1},
        "scale_numerator": {"type": "integer", "minimum": 1},
        "scale_denominator": {"type": "integer", "minimum": 1},
        "decimal_places": {"type": "integer", "minimum": 0, "maximum": 12},
        "rounding": {"const": "half_even"}
      }
    },
    "kpi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "canonical_unit",
        "availability",
        "value",
        "unavailable_reason",
        "aggregation_method",
        "sample_count",
        "sources",
        "scope",
        "calculation",
        "clock",
        "quality_warnings",
        "display"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "canonical_unit": {"type": "string", "minLength": 1},
        "availability": {
          "enum": ["available", "not_available", "not_collected", "error"]
        },
        "value": {"type": ["number", "null"]},
        "unavailable_reason": {"type": ["string", "null"], "minLength": 1},
        "aggregation_method": {"type": "string", "minLength": 1},
        "sample_count": {"type": "integer", "minimum": 0},
        "sources": {
          "type": "array",
          "items": {"$ref": "#/$defs/source"}
        },
        "scope": {"$ref": "#/$defs/scope"},
        "calculation": {"$ref": "#/$defs/calculation"},
        "clock": {"$ref": "#/$defs/clock"},
        "quality_warnings": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "display": {"$ref": "#/$defs/display"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"availability": {"const": "available"}},
            "required": ["availability"]
          },
          "then": {
            "properties": {
              "value": {"type": "number"},
              "unavailable_reason": {"type": "null"},
              "sample_count": {"minimum": 1},
              "sources": {"minItems": 1}
            }
          },
          "else": {
            "properties": {
              "value": {"type": "null"},
              "unavailable_reason": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "kpi_sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_facing_latency",
        "pipeline_latency",
        "throughput_and_tokens",
        "transfer"
      ],
      "properties": {
        "request_facing_latency": {
          "type": "array",
          "items": {"$ref": "#/$defs/kpi"}
        },
        "pipeline_latency": {
          "type": "array",
          "items": {"$ref": "#/$defs/kpi"}
        },
        "throughput_and_tokens": {
          "type": "array",
          "items": {"$ref": "#/$defs/kpi"}
        },
        "transfer": {
          "type": "array",
          "items": {"$ref": "#/$defs/kpi"}
        }
      }
    },
    "resource_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_name",
        "canonical_unit",
        "scope",
        "clock",
        "total_sample_count",
        "available_sample_count",
        "unavailable_sample_count",
        "availability_ratio",
        "first_timestamp_ns",
        "last_timestamp_ns",
        "coverage_ns",
        "aggregates",
        "quality_warnings"
      ],
      "properties": {
        "metric_name": {"type": "string", "pattern": "^resource\\."},
        "canonical_unit": {"type": "string", "minLength": 1},
        "scope": {"$ref": "#/$defs/scope"},
        "clock": {"$ref": "#/$defs/clock"},
        "total_sample_count": {"type": "integer", "minimum": 0},
        "available_sample_count": {"type": "integer", "minimum": 0},
        "unavailable_sample_count": {"type": "integer", "minimum": 0},
        "availability_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "first_timestamp_ns": {"type": ["integer", "null"], "minimum": 0},
        "last_timestamp_ns": {"type": ["integer", "null"], "minimum": 0},
        "coverage_ns": {"type": ["integer", "null"], "minimum": 0},
        "aggregates": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/kpi"}
        },
        "quality_warnings": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "native_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profiler_type",
        "source_role",
        "timestamp_ns",
        "duration_ns",
        "alignment_status",
        "alignment_method",
        "uncertainty_ns",
        "native_clock_domain",
        "native_timestamp_unit",
        "artifact_count",
        "opaque_rbln_pb",
        "native_event_alignment",
        "structure_analysis"
      ],
      "properties": {
        "profiler_type": {"type": "string", "minLength": 1},
        "source_role": {"type": "string", "minLength": 1},
        "timestamp_ns": {"type": "integer", "minimum": 0},
        "duration_ns": {"type": "integer", "minimum": 0},
        "alignment_status": {
          "enum": [
            "canonical",
            "aligned",
            "partial",
            "unaligned",
            "not_applicable",
            "not_available",
            "unknown"
          ]
        },
        "alignment_method": {"type": "string", "minLength": 1},
        "uncertainty_ns": {"type": "integer", "minimum": 0},
        "native_clock_domain": {"type": "string", "minLength": 1},
        "native_timestamp_unit": {"type": "string", "minLength": 1},
        "artifact_count": {"type": "integer", "minimum": 0},
        "opaque_rbln_pb": {"type": "boolean"},
        "native_event_alignment": {"type": "string", "minLength": 1},
        "structure_analysis": {"type": "string", "minLength": 1}
      }
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_scope",
        "benchmark_claim_allowed",
        "limitations",
        "policies"
      ],
      "properties": {
        "comparison_scope": {"type": "string", "minLength": 1},
        "benchmark_claim_allowed": {"type": "boolean"},
        "limitations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "policies": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request_observation_layers_separate",
            "timestamp_proximity_join",
            "unavailable_zero_fill",
            "native_clock_inference",
            "rbln_pb_parsing",
            "resource_device_aggregation"
          ],
          "properties": {
            "request_observation_layers_separate": {"const": true},
            "timestamp_proximity_join": {"const": false},
            "unavailable_zero_fill": {"const": false},
            "native_clock_inference": {"const": false},
            "rbln_pb_parsing": {"const": false},
            "resource_device_aggregation": {"const": false}
          }
        }
      }
    },
    "data_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_status",
        "canonical_marker_count",
        "marker_validation",
        "request_join",
        "alignment",
        "resource_samples",
        "profiler",
        "source_artifact_validation",
        "perfetto_sql_validation",
        "trace_sha256",
        "per_sample_stream_preserved",
        "cleanup_complete",
        "rbln_pb_policy",
        "sample_limitations"
      ],
      "properties": {
        "run_status": {
          "enum": [
            "planned",
            "running",
            "succeeded",
            "failed",
            "partial",
            "cancelled"
          ]
        },
        "canonical_marker_count": {"type": "integer", "minimum": 0},
        "marker_validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "missing_count",
            "duplicate_count",
            "pairing_violation_count",
            "order_violation_count"
          ],
          "properties": {
            "status": {"type": "string", "minLength": 1},
            "missing_count": {"type": "integer", "minimum": 0},
            "duplicate_count": {"type": "integer", "minimum": 0},
            "pairing_violation_count": {"type": "integer", "minimum": 0},
            "order_violation_count": {"type": "integer", "minimum": 0}
          }
        },
        "request_join": {
          "type": "object",
          "additionalProperties": false,
          "required": ["joined_count", "unjoined_count", "method"],
          "properties": {
            "joined_count": {"type": "integer", "minimum": 0},
            "unjoined_count": {"type": "integer", "minimum": 0},
            "method": {"type": "string", "minLength": 1}
          }
        },
        "alignment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "method", "offset_ns", "uncertainty_ns"],
          "properties": {
            "status": {
              "enum": [
                "canonical",
                "aligned",
                "partial",
                "unaligned",
                "not_applicable",
                "not_available",
                "unknown"
              ]
            },
            "method": {"type": ["string", "null"], "minLength": 1},
            "offset_ns": {"type": ["integer", "null"]},
            "uncertainty_ns": {"type": ["integer", "null"], "minimum": 0}
          }
        },
        "resource_samples": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "available", "unavailable"],
          "properties": {
            "total": {"type": "integer", "minimum": 0},
            "available": {"type": "integer", "minimum": 0},
            "unavailable": {"type": "integer", "minimum": 0}
          }
        },
        "profiler": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "native_alignment_status"],
          "properties": {
            "kind": {"type": "string", "minLength": 1},
            "native_alignment_status": {
              "enum": [
                "canonical",
                "aligned",
                "partial",
                "unaligned",
                "not_applicable",
                "not_available",
                "unknown"
              ]
            }
          }
        },
        "source_artifact_validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "valid",
            "closeout_artifact_count",
            "closeout_manifest_sha256",
            "roots"
          ],
          "properties": {
            "valid": {"type": "boolean"},
            "closeout_artifact_count": {"type": "integer", "minimum": 0},
            "closeout_manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "roots": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["root_id", "file_count", "fingerprint_sha256"],
                "properties": {
                  "root_id": {"type": "string", "minLength": 1},
                  "file_count": {"type": "integer", "minimum": 0},
                  "fingerprint_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        },
        "perfetto_sql_validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["valid", "query_count", "mismatches"],
          "properties": {
            "valid": {"type": "boolean"},
            "query_count": {"type": "integer", "minimum": 0},
            "mismatches": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "trace_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "per_sample_stream_preserved": {"type": "boolean"},
        "cleanup_complete": {"type": "boolean"},
        "rbln_pb_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classification",
            "structure_analysis",
            "raw_bytes_embedded"
          ],
          "properties": {
            "classification": {"type": "string", "minLength": 1},
            "structure_analysis": {"type": "string", "minLength": 1},
            "raw_bytes_embedded": {"const": false}
          }
        },
        "sample_limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "perfetto": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid",
        "trace",
        "counts",
        "query_count",
        "queries",
        "mismatches",
        "flow_endpoint_reconciliation",
        "artifact_validation",
        "toolchain"
      ],
      "properties": {
        "valid": {"type": "boolean"},
        "trace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size_bytes", "sha256"],
          "properties": {
            "size_bytes": {"type": "integer", "minimum": 0},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "annotations",
            "counters",
            "dangling_flows",
            "flows",
            "import_errors",
            "native_policy",
            "process",
            "slices",
            "step_annotations",
            "tracks"
          ],
          "properties": {
            "annotations": {"type": "integer", "minimum": 0},
            "counters": {"type": "integer", "minimum": 0},
            "dangling_flows": {"type": "integer", "minimum": 0},
            "flows": {"type": "integer", "minimum": 0},
            "import_errors": {"type": "integer", "minimum": 0},
            "native_policy": {"type": "integer", "minimum": 0},
            "process": {"type": "integer", "minimum": 0},
            "slices": {"type": "integer", "minimum": 0},
            "step_annotations": {"type": "integer", "minimum": 0},
            "tracks": {"type": "integer", "minimum": 0}
          }
        },
        "query_count": {"type": "integer", "minimum": 0},
        "queries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "row_count",
              "rows_sha256",
              "expected_row_count",
              "expected_rows_sha256",
              "matched"
            ],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "row_count": {"type": "integer", "minimum": 0},
              "rows_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "expected_row_count": {"type": "integer", "minimum": 0},
              "expected_rows_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "matched": {"type": "boolean"}
            }
          }
        },
        "mismatches": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "flow_endpoint_reconciliation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "declared_flow_ids",
            "source_endpoint_ids",
            "destination_endpoint_ids",
            "matched"
          ],
          "properties": {
            "declared_flow_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "integer", "minimum": 1}
            },
            "source_endpoint_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "integer", "minimum": 1}
            },
            "destination_endpoint_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "integer", "minimum": 1}
            },
            "matched": {"type": "boolean"}
          }
        },
        "artifact_validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["valid", "checked", "mismatches", "manifest_sha256"],
          "properties": {
            "valid": {"type": "boolean"},
