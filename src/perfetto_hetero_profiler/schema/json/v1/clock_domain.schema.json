{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfetto-hetero-profiler.local/schema/v1/clock_domain.schema.json",
  "title": "ClockDomain v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "run_id", "clock_domain_id", "host_id", "clock_type", "unit", "monotonic", "adjustable", "attributes"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
    "record_type": {"const": "clock_domain"},
    "run_id": {"type": "string", "minLength": 1},
    "clock_domain_id": {"type": "string", "minLength": 1},
    "host_id": {"type": "string", "minLength": 1},
    "clock_type": {"enum": ["monotonic", "monotonic_raw", "realtime", "perf_counter", "cuda", "rbln", "external"]},
    "unit": {"const": "ns"},
    "monotonic": {"type": "boolean"},
    "adjustable": {"type": "boolean"},
    "attributes": {"type": "object"}
  }
}
